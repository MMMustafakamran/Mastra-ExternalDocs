# ─────────────────────────────────────────────────────────────────────────────
#  Mastra · CopilotKit external-docs harness
#
#  Copy to `.env` and fill in. The page's step 1 says only "Ensure that you have
#  set the appropriate environment variables for your LLM provider in the .env
#  file" and never names one — the model ids in its snippets are
#  `openai/gpt-5.6-luna`, so OpenAI is the provider they imply.
# ─────────────────────────────────────────────────────────────────────────────

OPENAI_API_KEY=sk-...

# ── Ports ────────────────────────────────────────────────────────────────────
# 4111 is the page's own default, and every published frontend snippet
# hardcodes `runtimeUrl="http://localhost:4111/copilotkit"`. Moving it means
# editing a doc snippet.
MASTRA_PORT=4111
MASTRA_URL=http://localhost:4111

# 3303, not the page's 3000. Eleven sibling repos in this workspace default to
# 3000; the external-docs repos take 3301 (ag2), 3302 (agno), 3303 (mastra).
FRONTEND_PORT=3303
FRONTEND_URL=http://localhost:3303

# ── Not used by the recorded routes ──────────────────────────────────────────
# The Channels section needs a Slack app. Left here so the section is visibly
# accounted for rather than silently skipped.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
